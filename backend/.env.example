API_PORT=8000
DEBUG_PORT=5678
PYTHONPATH=app

# Mongo (matches docker_compose/mongo.yaml — auth required when using init credentials)
MONGO_USERNAME=admin
MONGO_PASSWORD=admin
MONGO_DB_CONNECTION_URI=mongodb://admin:admin@mongodb:27017/?authSource=admin
MONGODB_DATABASE=alpaca_astro_center

KAFKA_URL=kafka:29092
TELESCOPE_OPERATION_TOPIC=telescope-operation-events
MODEL_INFERENCE_REQUEST_TOPIC=model-inference-request
MODEL_INFERENCE_RESULT_TOPIC=model-inference-result

# Model microservice runtime profile/settings (used by docker_compose/model-service.yaml)
MODEL_SERVICE_PORT=8010
MODEL_RUNTIME_PROFILE=cpu
MODEL_WORKER_ENABLED=true
MODEL_SERVICE_SOURCE=local-model-service

# Optional live Alpaca poll for GET /telescopes/status (off by default in Docker LAN setups)
ALPACA_ENABLED=false
ALPACA_ADDRESS=host.docker.internal:11111
ALPACA_DEVICE_NUMBER=0
ALPACA_PROTOCOL=http
ALPACA_CONNECT_TIMEOUT_SECONDS=8.0
# Alpaca on LAN (example only; use your device host:port):
# ALPACA_ENABLED=true
# ALPACA_ADDRESS=192.0.2.10:32323

# RTSP camera → MJPEG at GET /api/v1/telescope/stream (empty = disabled). TCP is recommended on many LANs.
TELESCOPE_RTSP_URL=
TELESCOPE_RTSP_TRANSPORT_TCP=true
# Optional tuning (defaults match FastAPI settings if omitted):
# TELESCOPE_RTSP_MAX_FRAME_WIDTH=1280
# TELESCOPE_RTSP_JPEG_QUALITY=80
# Optional guard for unsafe hardware commands (slew/sync/tracking).
# If set, clients must send X-Command-Token header to command endpoints.
COMMAND_AUTH_TOKEN=
# Command audits are persisted into MONGODB_OPERATION_COLLECTION.

# Operator live FOV: absolute http(s) URL returned by GET /telescopes/operator/live-view (MJPEG/still on LAN). Optional.
# OPERATOR_LIVE_VIEW_IMAGE_URL=http://192.168.1.50:8080/video.mjpg

# CORS (FastAPI). Comma-separated origins. Omit for defaults (includes localhost:5173); set empty string to disable CORS middleware.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Sesame / CDS name lookups (needs outbound network). Keeps CI stacks deterministic when false.
CATALOG_LOOKUP_ENABLED=false
CATALOG_RESOLVE_TIMEOUT_SECONDS=20.0

# Optional Skyfield ephemeris (Solar System ICRS coordinates).
EPHEMERIS_ENABLED=false
EPHEMERIS_KERNEL=de421.bsp
