API_PORT=8000
DEBUG_PORT=5678
PYTHONPATH=app

# Mongo (matches docker_compose/mongo.yaml — auth required when using init credentials)
MONGO_USERNAME=admin
MONGO_PASSWORD=admin
MONGO_DB_CONNECTION_URI=mongodb://admin:admin@mongodb:27017/?authSource=admin
MONGODB_DATABASE=alpaca_astro_center

KAFKA_URL=kafka:29092

# Optional live Alpaca poll for GET /telescopes/status (off by default in Docker LAN setups)
ALPACA_ENABLED=false
ALPACA_ADDRESS=host.docker.internal:11111
ALPACA_DEVICE_NUMBER=0
ALPACA_PROTOCOL=http
ALPACA_CONNECT_TIMEOUT_SECONDS=8.0
