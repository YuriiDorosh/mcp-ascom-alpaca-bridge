    {
      "name": "03e - MCP Execution Plan",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('mcp execution plan returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('mcp execution plan includes steps and readiness', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('hardware_readiness');",
              "  pm.expect(json).to.have.property('hardware_smoke_plan');",
              "  pm.expect(json).to.have.property('hardware_validation_plan');",
              "  pm.expect(json.hardware_smoke_plan.trigger_task_id).to.eql('P5-HW-SMOKE');",
              "  pm.expect(json.hardware_validation_plan.trigger_task_id).to.eql('P5-HW-VALIDATION');",
              "  pm.expect(Array.isArray(json.hardware_smoke_plan.steps)).to.eql(true);",
              "  pm.expect(Array.isArray(json.hardware_validation_plan.steps)).to.eql(true);",
              "  pm.expect(json.hardware_smoke_plan.steps.length).to.be.above(0);",
              "  pm.expect(json.hardware_validation_plan.steps.length).to.be.above(0);",
              "  const planStep = json.hardware_smoke_plan.steps[0];",
              "  const validationPlanStep = json.hardware_validation_plan.steps[0];",
              "  pm.expect(planStep).to.have.property('step');",
              "  pm.expect(planStep).to.have.property('action');",
              "  pm.expect(planStep).to.have.property('expected_result');",
              "  pm.expect(validationPlanStep).to.have.property('step');",
              "  pm.expect(validationPlanStep).to.have.property('action');",
              "  pm.expect(validationPlanStep).to.have.property('expected_result');",
              "  pm.expect(json).to.have.property('applied_filters');",
              "  pm.expect(json.applied_filters.include_disabled_commands).to.eql(true);",
              "  pm.expect(json).to.have.property('stats');",
              "  pm.expect(json.stats.baseline_steps).to.be.a('number');",
              "  pm.expect(json.stats.returned_steps).to.be.a('number');",
              "  pm.expect(json.stats.filtered_out_steps).to.be.a('number');",
              "  pm.expect(json.stats.returned_steps).to.eql(json.stats.baseline_steps);",
              "  pm.expect(json.stats.filtered_out_steps).to.eql(0);",
              "  pm.expect(json).to.have.property('steps');",
              "  pm.expect(Array.isArray(json.steps)).to.eql(true);",
              "  pm.expect(json.steps.length).to.be.above(0);",
              "  const first = json.steps[0];",
              "  pm.expect(first).to.have.property('enabled');",
              "  pm.expect(first).to.have.property('skip_reason');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/telescopes/tools/mcp-execution-plan"
      }
    },
    {
      "name": "03f - MCP Execution Plan Sync Mode",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('mcp execution plan sync returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('mcp execution plan sync mode uses single-call inference step', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.mode).to.eql('sync');",
              "  pm.expect(json.hardware_smoke_plan.trigger_task_id).to.eql('P5-HW-SMOKE');",
              "  pm.expect(json.hardware_validation_plan.trigger_task_id).to.eql('P5-HW-VALIDATION');",
              "  pm.expect(json.hardware_smoke_plan.steps[0]).to.have.property('step');",
              "  pm.expect(json.hardware_smoke_plan.steps[0]).to.have.property('action');",
              "  pm.expect(json.hardware_smoke_plan.steps[0]).to.have.property('expected_result');",
              "  pm.expect(json.hardware_validation_plan.steps[0]).to.have.property('step');",
              "  pm.expect(json.hardware_validation_plan.steps[0]).to.have.property('action');",
              "  pm.expect(json.hardware_validation_plan.steps[0]).to.have.property('expected_result');",
              "  pm.expect(Array.isArray(json.steps)).to.eql(true);",
              "  const names = json.steps.map((item) => item.tool_name);",
              "  pm.expect(names).to.include('model.enqueue_and_wait_inference');",
              "  pm.expect(names).to.not.include('model.enqueue_inference');",
              "  pm.expect(names).to.not.include('model.get_inference_status');",
              "  pm.expect(names).to.not.include('model.wait_inference_result');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/telescopes/tools/mcp-execution-plan?mode=sync"
      }
    },
    {
      "name": "03g - MCP Execution Plan Runnable Commands",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('mcp execution plan runnable returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('mcp execution plan runnable omits disabled command tools', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.hardware_smoke_plan.trigger_task_id).to.eql('P5-HW-SMOKE');",
              "  pm.expect(json.hardware_validation_plan.trigger_task_id).to.eql('P5-HW-VALIDATION');",
              "  pm.expect(Array.isArray(json.hardware_smoke_plan.steps)).to.eql(true);",
              "  pm.expect(Array.isArray(json.hardware_validation_plan.steps)).to.eql(true);",
              "  pm.expect(json.hardware_smoke_plan.steps.length).to.be.above(0);",
              "  pm.expect(json.hardware_validation_plan.steps.length).to.be.above(0);",
              "  pm.expect(json.hardware_smoke_plan.steps[0]).to.have.property('step');",
              "  pm.expect(json.hardware_smoke_plan.steps[0]).to.have.property('action');",
              "  pm.expect(json.hardware_smoke_plan.steps[0]).to.have.property('expected_result');",
              "  pm.expect(json.hardware_validation_plan.steps[0]).to.have.property('step');",
              "  pm.expect(json.hardware_validation_plan.steps[0]).to.have.property('action');",
              "  pm.expect(json.hardware_validation_plan.steps[0]).to.have.property('expected_result');",
              "  pm.expect(json).to.have.property('applied_filters');",
              "  pm.expect(json.applied_filters.include_disabled_commands).to.eql(false);",
              "  pm.expect(json).to.have.property('stats');",
              "  pm.expect(json.stats.returned_steps).to.be.below(json.stats.baseline_steps);",
              "  pm.expect(json.stats.filtered_out_steps).to.be.a('number');",
              "  pm.expect(json.stats.filtered_out_steps).to.eql(json.stats.baseline_steps - json.stats.returned_steps);",
              "  pm.expect(Array.isArray(json.steps)).to.eql(true);",
              "  const names = json.steps.map((item) => item.tool_name);",
              "  pm.expect(names).to.not.include('telescope.sync_icrs');",
              "  pm.expect(names).to.not.include('telescope.set_tracking');",
              "  const commandSteps = json.steps.filter((item) => item.tool_name.startsWith('telescope.') && ['telescope.slew_icrs', 'telescope.sync_icrs', 'telescope.set_tracking'].includes(item.tool_name));",
              "  commandSteps.forEach((item) => pm.expect(item.enabled).to.eql(true));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/telescopes/tools/mcp-execution-plan?include_disabled_commands=false"
      }
    },
