    {
      "name": "03c - MCP Bootstrap Bundle",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('mcp bootstrap returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('mcp bootstrap includes effective_manifest tools', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('effective_manifest');",
              "  pm.expect(json.effective_manifest).to.have.property('tools');",
              "  pm.expect(Array.isArray(json.effective_manifest.tools)).to.eql(true);",
              "  pm.expect(json.effective_manifest.tools.length).to.be.above(0);",
              "  pm.expect(json).to.have.property('hardware_smoke_plan');",
              "  pm.expect(json).to.have.property('hardware_validation_plan');",
              "  pm.expect(json.hardware_smoke_plan.trigger_task_id).to.eql('P5-HW-SMOKE');",
              "  pm.expect(json.hardware_validation_plan.trigger_task_id).to.eql('P5-HW-VALIDATION');",
              "  pm.expect(Array.isArray(json.hardware_smoke_plan.steps)).to.eql(true);",
              "  pm.expect(Array.isArray(json.hardware_validation_plan.steps)).to.eql(true);",
              "  pm.expect(json.hardware_smoke_plan.steps.length).to.be.above(0);",
              "  pm.expect(json.hardware_validation_plan.steps.length).to.be.above(0);",
              "  const smokeStep = json.hardware_smoke_plan.steps[0];",
              "  const validationStep = json.hardware_validation_plan.steps[0];",
              "  pm.expect(smokeStep).to.have.property('step');",
              "  pm.expect(smokeStep).to.have.property('action');",
              "  pm.expect(smokeStep).to.have.property('expected_result');",
              "  pm.expect(validationStep).to.have.property('step');",
              "  pm.expect(validationStep).to.have.property('action');",
              "  pm.expect(validationStep).to.have.property('expected_result');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/telescopes/tools/mcp-bootstrap"
      }
    },
