{
  "info": {
    "_postman_id": "3f742188-0b09-4c6c-a83f-b6da3cf4e724",
    "name": "Alpaca Astro Center API - Smoke",
    "description": "Sequential smoke checks for local stack bring-up and quick API sanity validation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Telescope Status",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status endpoint returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/telescopes/status"
      }
    },
    {
      "name": "02 - MCP Tool Manifest",
