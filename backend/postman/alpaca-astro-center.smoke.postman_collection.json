          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/telescopes/tools/mcp-manifest"
      }
    },
    {
      "name": "03 - Enqueue Inference",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('enqueue returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "if (json.request_id) {",
              "  pm.environment.set('request_id', json.request_id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"Smoke test: return short acknowledgment\"\n}"
        },
        "url": "{{base_url}}/telescopes/model/inference"
      }
    },
    {
      "name": "03a - MCP Effective Manifest",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('mcp effective manifest returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('mcp effective manifest has enabled and disabled_reason fields', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(Array.isArray(json.tools)).to.eql(true);",
              "  pm.expect(json.tools.length).to.be.above(0);",
              "  const first = json.tools[0];",
              "  pm.expect(first).to.have.property('enabled');",
              "  pm.expect(first).to.have.property('disabled_reason');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/telescopes/tools/mcp-manifest/effective"
      }
    },
    {
      "name": "03b - MCP Planning Guide",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('mcp planning guide returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/telescopes/tools/mcp-planning-guide"
      }
    },
    {
      "name": "03c - MCP Bootstrap Bundle",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('mcp bootstrap returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('mcp bootstrap includes effective_manifest tools', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('effective_manifest');",
              "  pm.expect(json.effective_manifest).to.have.property('tools');",
              "  pm.expect(Array.isArray(json.effective_manifest.tools)).to.eql(true);",
              "  pm.expect(json.effective_manifest.tools.length).to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/telescopes/tools/mcp-bootstrap"
      }
    },
    {
      "name": "03d - Hardware Readiness",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('hardware readiness returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('hardware readiness has trigger task', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.requires_real_telescope_now).to.eql(false);",
              "  pm.expect(json.trigger_task_id).to.eql('P5-HW-SMOKE');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/telescopes/hardware/readiness"
      }
    },
    {
      "name": "03e - MCP Execution Plan",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('mcp execution plan returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('mcp execution plan includes steps and readiness', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('hardware_readiness');",
              "  pm.expect(json).to.have.property('steps');",
              "  pm.expect(Array.isArray(json.steps)).to.eql(true);",
              "  pm.expect(json.steps.length).to.be.above(0);",
              "  const first = json.steps[0];",
              "  pm.expect(first).to.have.property('enabled');",
              "  pm.expect(first).to.have.property('skip_reason');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/telescopes/tools/mcp-execution-plan"
      }
    },
    {
      "name": "03f - MCP Execution Plan Sync Mode",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('mcp execution plan sync returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('mcp execution plan sync mode uses single-call inference step', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.mode).to.eql('sync');",
              "  pm.expect(Array.isArray(json.steps)).to.eql(true);",
              "  const names = json.steps.map((item) => item.tool_name);",
              "  pm.expect(names).to.include('model.enqueue_and_wait_inference');",
              "  pm.expect(names).to.not.include('model.enqueue_inference');",
              "  pm.expect(names).to.not.include('model.get_inference_status');",
              "  pm.expect(names).to.not.include('model.wait_inference_result');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/telescopes/tools/mcp-execution-plan?mode=sync"
      }
    },
